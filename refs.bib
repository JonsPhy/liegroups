@article{Attarddressingfieldmethodgaugesymmetryreductionreviewexamples2017,
  title = {The Dressing Field Method of Gauge Symmetry Reduction, a Review with Examples},
  author = {Attard, J. and François, J. and Lazzarini, S. and Masson, T.},
  date = {2017},
  publisher = {arXiv},
  doi = {10.48550/ARXIV.1702.02753},
  url = {https://arxiv.org/abs/1702.02753},
  urldate = {2026-05-13},
  abstract = {Gauge symmetries are a cornerstone of modern physics but they come with technical difficulties when it comes to quantization, to accurately describe particles phenomenology or to extract observables in general. These shortcomings must be met by essentially finding a way to effectively reduce gauge symmetries. We propose a review of a way to do so which we call the dressing field method. We show how the BRST algebra satisfied by gauge fields, encoding their gauge transformations, is modified. We outline noticeable applications of the method, such as the electroweak sector of the Standard Model and the local twistors of Penrose.},
  version = {1},
  keywords = {arXiv,BFT-BFV,BV Formalism,Differential Geometry (math.DG),Dressing Field Method,Electroweak Theory,FOS: Mathematics,FOS: Physical sciences,Gauge Symmetry Reduction,General Relativity and Quantum Cosmology (gr-qc),Higgs Mechanism,High Energy Physics - Theory (hep-th),Mathematical Physics (math-ph),Thesis Literature},
  file = {/Users/jonasvonstein/Zotero/storage/NUZSR5R2/Attard et al. - 2017 - The dressing field method of gauge symmetry reduction, a review with examples.pdf}
}

